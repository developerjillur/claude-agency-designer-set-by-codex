{
  "schema": "nexa.platforms/1",
  "verified_on": "2026-09-26",
  "note": "Field limits and rules per copy type, read on official pages on 2026-09-26 (research/R5-copywriting.md §6, R6-email-and-outbound.md §11, R7-product-copy.md §2). Platforms change these often: re-read the official page at job time and update this file with the date. 'unverified' marks limits a seller login or bot wall kept us from confirming.",
  "types": {
    "google-rsa": {"family": "ad", "label": "Google Search responsive search ad", "source": "R5 6.1",
      "fields": {"headline": {"max_chars": 30, "min_count": 3, "max_count": 15},
                 "description": {"max_chars": 90, "min_count": 2, "max_count": 4},
                 "path": {"max_chars": 15, "max_count": 2}},
      "tips": "Supply many unique headlines of varied length; each must read well beside any other; pin only when a message must always show."},
    "google-pmax": {"family": "ad", "label": "Google Performance Max", "source": "R5 6.1",
      "fields": {"headline": {"max_chars": 30, "min_count": 3, "max_count": 15, "one_at_most": 15},
                 "long_headline": {"max_chars": 90, "min_count": 1, "max_count": 5},
                 "description": {"max_chars": 90, "min_count": 2, "max_count": 5},
                 "business_name": {"max_chars": 25, "max_count": 1}}},
    "google-demandgen": {"family": "ad", "label": "Google Demand Gen (image)", "source": "R5 6.1",
      "fields": {"headline": {"max_chars": 40, "max_count": 5}, "description": {"max_chars": 90, "max_count": 5}}},
    "youtube-shorts-ad": {"family": "ad", "label": "YouTube Shorts ad CTA card", "source": "R5 6.1",
      "fields": {"headline": {"max_chars": 40}, "description": {"max_chars": 90}}},
    "meta-feed": {"family": "ad", "label": "Meta ad, Facebook and Instagram feed", "source": "R5 6.1, 6.3",
      "fields": {"primary": {"rec_chars": [50, 150], "fold_chars": 125},
                 "headline": {"rec_chars": [1, 27], "max_chars": 40},
                 "description": {"rec_chars": [1, 30]},
                 "cta": {"max_words": 4}},
      "tips": "The whole sale lands in the first 125 characters of the primary text."},
    "meta-stories": {"family": "ad", "label": "Meta ad, Stories, Reels, Marketplace, Search", "source": "R5 6.1",
      "fields": {"primary": {"rec_chars": [1, 125], "fold_chars": 125}, "headline": {"rec_chars": [1, 40]},
                 "description": {"rec_chars": [1, 30]}, "cta": {"max_words": 4}}},
    "linkedin-ad": {"family": "ad", "label": "LinkedIn sponsored content (single image)", "source": "R5 6.1, 6.3",
      "fields": {"intro": {"rec_chars": [1, 150], "fold_chars": 140}, "headline": {"rec_chars": [1, 70]},
                 "description": {"rec_chars": [1, 100]}, "cta": {"max_words": 4}}},
    "tiktok-ad": {"family": "ad", "label": "TikTok in-feed ad (not Spark)", "source": "R5 6.1",
      "fields": {"ad_text": {"max_chars": 100, "no_hashtags": true, "no_mentions": true, "no_links": true, "no_emoji": true},
                 "display_name": {"max_chars": 20}},
      "tips": "The 100-character cap is widely cited but secondary; up to 4 lines show."},
    "instagram": {"family": "post", "label": "Instagram caption", "source": "R5 6.2, 6.4",
      "fields": {"caption": {"max_chars": 2200, "fold_chars": 125, "max_hashtags": 5}},
      "tips": "Hashtags label content and add no reach (Mosseri); 3 to 5 specific ones at most."},
    "facebook": {"family": "post", "label": "Facebook post", "source": "R5 6.2; natural-text",
      "fields": {"caption": {"fold_chars": 125, "max_hashtags": 3}}},
    "linkedin": {"family": "post", "label": "LinkedIn post", "source": "R5 6.2, 6.4",
      "fields": {"caption": {"max_chars": 3000, "fold_chars": 140}}},
    "x": {"family": "post", "label": "X post", "source": "R5 6.2",
      "fields": {"caption": {"max_chars": 280, "x_counting": true}}},
    "threads": {"family": "post", "label": "Threads post", "source": "R5 6.2",
      "fields": {"caption": {"max_chars": 500}}},
    "tiktok": {"family": "post", "label": "TikTok caption", "source": "R5 6.2",
      "fields": {"caption": {"max_chars": 4000, "fold_chars": 100}}},
    "youtube": {"family": "post", "label": "YouTube title and description", "source": "R5 6.2",
      "fields": {"title": {"max_chars": 100, "rec_chars": [1, 70]}, "description": {"max_chars": 5000, "fold_chars": 150}}},
    "email-cold": {"family": "outbound", "label": "Cold email, first touch", "source": "R6 6, 11",
      "fields": {"subject": {"rec_words": [2, 6]}, "body": {"rec_words": [50, 90], "max_words": 100, "max_sentences": 6}},
      "rules": {"no_links": true, "must_end_question": true, "max_questions": 2, "you_over_i": true, "needs_optout": true,
                "needs_address": true, "grade": [3, 6]}},
    "email-followup": {"family": "outbound", "label": "Cold email follow-up", "source": "R6 6.3, 11",
      "fields": {"body": {"rec_words": [25, 60], "max_words": 80}},
      "rules": {"max_links": 1, "you_over_i": true, "grade": [3, 6]}},
    "email-breakup": {"family": "outbound", "label": "Cold email breakup", "source": "R6 6.3, 11",
      "fields": {"body": {"rec_words": [20, 40], "max_words": 60}}, "rules": {"max_links": 0}},
    "email-welcome": {"family": "email", "label": "Welcome email", "source": "R6 4, 11",
      "fields": {"subject": {"rec_chars": [20, 40]}, "preview": {"rec_chars": [35, 90]}, "body": {"rec_words": [60, 120]}},
      "rules": {"needs_preview": true, "needs_unsubscribe": true, "needs_address": true, "one_cta": true, "grade": [5, 8]}},
    "email-cart": {"family": "email", "label": "Abandoned cart email", "source": "R6 4, 11",
      "fields": {"subject": {"rec_chars": [25, 35]}, "preview": {"rec_chars": [35, 90]}, "body": {"rec_words": [40, 90]}},
      "rules": {"needs_preview": true, "needs_unsubscribe": true, "needs_address": true, "one_cta": true, "grade": [5, 8]}},
    "email-promo": {"family": "email", "label": "Promotional email", "source": "R6 5, 11",
      "fields": {"subject": {"rec_chars": [1, 40]}, "preview": {"rec_chars": [35, 90]}, "body": {"rec_words": [80, 200]}},
      "rules": {"needs_preview": true, "needs_unsubscribe": true, "needs_address": true, "links": [2, 5], "one_cta": true,
                "grade": [5, 8]}},
    "email-newsletter": {"family": "email", "label": "Newsletter issue", "source": "R6 5, 11",
      "fields": {"subject": {"rec_chars": [20, 40]}, "preview": {"rec_chars": [35, 90]}, "body": {"rec_words": [250, 600]}},
      "rules": {"needs_preview": true, "needs_unsubscribe": true, "needs_address": true, "links": [2, 5], "grade": [6, 8]}},
    "proposal": {"family": "outbound", "label": "Upwork proposal, message 1 (the reply-winner)", "source": "R6 8",
      "fields": {"body": {"rec_words": [50, 110], "max_words": 150}},
      "rules": {"no_contact_details": true, "max_links": 1, "grade": [3, 7]}},
    "proposal-plan": {"family": "outbound", "label": "Upwork proposal, message 2 (the plan)", "source": "R6 8",
      "fields": {"body": {"rec_words": [300, 450], "max_words": 500}}, "rules": {"no_contact_details": true}},
    "linkedin-note": {"family": "outbound", "label": "LinkedIn connection note", "source": "R6 9",
      "fields": {"body": {"max_chars": 300, "rec_chars": [1, 200]}}, "rules": {"no_links": true}},
    "linkedin-dm": {"family": "outbound", "label": "LinkedIn DM", "source": "R6 9",
      "fields": {"body": {"rec_words": [30, 60], "max_words": 80}}, "rules": {"max_links": 0}},
    "amazon": {"family": "product", "label": "Amazon listing", "source": "R7 2.2",
      "fields": {"title": {"max_chars": 75, "banned_chars": "!$?_{}^¬¦", "max_word_repeat": 2},
                 "highlights": {"max_chars": 125},
                 "bullet": {"min_count": 3, "max_count": 5, "max_chars": 255, "min_chars": 10, "no_emoji": true},
                 "description": {"max_chars": 2000},
                 "search_terms": {"max_bytes": 249}},
      "rules": {"marketplace": true},
      "tips": "Titles are 75 characters in every store but SA, EG, TR, AE (media exempt); size and colour go in child titles."},
    "google-merchant": {"family": "product", "label": "Google Merchant Center feed", "source": "R7 2.3",
      "fields": {"title": {"max_chars": 150, "fold_chars": 70},
                 "highlight": {"max_chars": 150, "min_count": 2, "max_count": 100},
                 "description": {"max_chars": 5000, "fold_chars": 160},
                 "qa": {"max_chars": 1000, "max_count": 30}},
      "rules": {"marketplace": true}},
    "shopify": {"family": "product", "label": "Shopify product page", "source": "R7 2.4",
      "fields": {"seo_title": {"max_chars": 70, "rec_chars": [1, 60]}, "meta_description": {"rec_chars": [50, 160]},
                 "description": {}}},
    "ebay": {"family": "product", "label": "eBay listing", "source": "R7 2.6",
      "fields": {"title": {"max_chars": 80}, "description": {}}, "rules": {"marketplace": true}},
    "walmart": {"family": "product", "label": "Walmart Marketplace listing", "source": "R7 2.7",
      "fields": {"title": {"max_chars": 150, "rec_chars": [50, 75], "banned_chars": "~!*$"},
                 "key_feature": {"max_chars": 80, "min_count": 3, "max_count": 10},
                 "description": {"min_words": 150, "one_paragraph": true, "no_emoji": true}},
      "rules": {"marketplace": true}},
    "etsy": {"family": "product", "label": "Etsy listing (limits unverified)", "source": "R7 2.5",
      "fields": {"title": {"max_chars": 140}, "tag": {"max_chars": 20, "max_count": 13}, "description": {}},
      "rules": {"marketplace": true}},
    "daraz": {"family": "product", "label": "Daraz listing (limits unverified, behind seller login)", "source": "R7 2.8, 6",
      "fields": {"title": {}, "highlight": {}, "description": {}}, "rules": {"marketplace": true, "bd_commerce": true}},
    "fb-shop": {"family": "product", "label": "Facebook or Instagram shop post (Bangladesh f-commerce)", "source": "R7 6",
      "fields": {"caption": {"fold_chars": 125, "max_hashtags": 3}}, "rules": {"bd_commerce": true}},
    "landing": {"family": "landing", "label": "Landing page hero and blocks", "source": "R5 3, 11.2",
      "fields": {"h1": {"rec_words": [3, 12]}, "subhead": {"rec_words": [10, 35]}, "button": {"max_words": 5},
                 "feature": {}, "faq": {}}, "rules": {"one_cta": true, "grade": [5, 7]}},
    "whatsapp": {"family": "message", "label": "WhatsApp message", "source": "natural-text",
      "fields": {"body": {"rec_words": [1, 80], "max_hashtags": 0}}},
    "sms": {"family": "message", "label": "SMS", "source": "natural-text",
      "fields": {"body": {"sms_parts": true}}}
  }
}
